{
  // p11 示範用：只檢查、不輸出，不影響 npm run build
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "noEmit": true,
    // p11 的主角。改成 false 看紅線變少，示範完當場改回 true。
    // 注意：TypeScript 6 以後不寫 strict 預設就是 true，要關掉必須明寫 false，註解掉沒有用。
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["."]
}
